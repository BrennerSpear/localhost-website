{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localhost-website",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "localhostai.nyc", "custom_domain": true },
    { "pattern": "www.localhostai.nyc", "custom_domain": true }
  ]
}
